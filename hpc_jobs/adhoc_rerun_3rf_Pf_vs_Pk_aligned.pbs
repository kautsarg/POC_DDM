#!/bin/bash
#PBS -N adhoc_3rf_Pf_vs_Pk_aligned
#PBS -l walltime=24:00:00
#PBS -l select=1:ncpus=8:mem=32gb:ngpus=1
#PBS -o /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/adhoc_3rf_Pf_vs_Pk_aligned/
#PBS -e /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/adhoc_3rf_Pf_vs_Pk_aligned/
#PBS -k eo

set -e

mkdir -p /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/adhoc_3rf_Pf_vs_Pk_aligned

module load Python/3.12.3-GCCcore-13.3.0
module load CUDA/12.6.0
module load cuDNN/9.10.2.21-CUDA-12.6.0

source /rds/general/user/gk225/home/venv_poc_ddm/bin/activate
export PYTHONPATH="/rds/general/user/gk225/home/POC_DDM:/rds/general/user/gk225/home/POC_DDM/gk_code:$PYTHONPATH"
cd /rds/general/user/gk225/home/POC_DDM/gk_code/main

EXP_FOLDER=/rds/general/user/gk225/home/refactor/POC_DDM_datasets/LAB_OneToOne
TRAIN_FOLDER="$EXP_FOLDER"
ALIGNED_TID=40   # 3_range_filtered__Pf_vs_Pk_aligned

python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/03_main_training.py --task_id $ALIGNED_TID --exp_folder "$TRAIN_FOLDER" --n_splits 5 --curve_type ori_curve
python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/03_main_training.py --task_id $ALIGNED_TID --exp_folder "$TRAIN_FOLDER" --n_splits 5 --curve_type ori_curve_norm
python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/06_model_prediction_report.py --task_id $ALIGNED_TID --exp_folder "$TRAIN_FOLDER" --n_splits 5 --curve_type ori_curve
python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/06_model_prediction_report.py --task_id $ALIGNED_TID --exp_folder "$TRAIN_FOLDER" --n_splits 5 --curve_type ori_curve_norm

deactivate
