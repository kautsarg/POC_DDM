#!/bin/bash
#PBS -N lab_full_pipeline
#PBS -l walltime=72:00:00
#PBS -l select=1:ncpus=8:mem=32gb:ngpus=1
#PBS -J 0-2
#PBS -o /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/lab_full_pipeline/
#PBS -e /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/lab_full_pipeline/
#PBS -k eo

set -e

mkdir -p /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/lab_full_pipeline

# Load modules
module load Python/3.12.3-GCCcore-13.3.0
module load CUDA/12.6.0
module load cuDNN/9.10.2.21-CUDA-12.6.0

# Activate venv
source /rds/general/user/gk225/home/venv_poc_ddm/bin/activate

export PYTHONPATH="/rds/general/user/gk225/home/POC_DDM:/rds/general/user/gk225/home/POC_DDM/gk_code:$PYTHONPATH"

cd /rds/general/user/gk225/home/POC_DDM/gk_code/main

REAL_TASK_ID=$((PBS_ARRAY_INDEX))

EXP_FOLDER=/rds/general/user/gk225/home/POC_DDM_datasets/POC_DDM_datasets/LAB_DDM_paper

TRAIN_FOLDER="$EXP_FOLDER"

# LAB_DDM_paper has no spatial grid and no ori_curves_avg variant (see
# 01b_lab_curve_preprocessing.py) -- pass --curve_type ori_curve explicitly to 03/05/06/07,
# since their default ["ori_curve", "ori_curve_avg"] makes 05/06/07 hard-fail
# (config.resolve_curve_dataset_idx raises ValueError) the moment "ori_curves_avg" isn't found.
python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/01b_lab_curve_preprocessing.py --task_id $REAL_TASK_ID --exp_folder "$EXP_FOLDER" --force_rerun
python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/02_outlier_detection_pipeline.py --task_id $REAL_TASK_ID --exp_folder "$TRAIN_FOLDER" --force_rerun
python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/03_main_training.py --task_id $REAL_TASK_ID --exp_folder "$TRAIN_FOLDER" --n_splits 1 --curve_type ori_curve --force_rerun
python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/05_outlier_visualization_report.py --task_id $REAL_TASK_ID --exp_folder "$TRAIN_FOLDER" --curve_type ori_curve --force_rerun
python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/06_model_prediction_report.py --task_id $REAL_TASK_ID --exp_folder "$TRAIN_FOLDER" --curve_type ori_curve --force_rerun
python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/07_attribution_vis_all.py --task_id $REAL_TASK_ID --exp_folder "$TRAIN_FOLDER" --curve_type ori_curve --force_rerun

deactivate
