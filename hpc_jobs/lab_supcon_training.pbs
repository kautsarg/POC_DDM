#!/bin/bash
#PBS -N lab_supcon_training
#PBS -l walltime=72:00:00
#PBS -l select=1:ncpus=8:mem=32gb:ngpus=1
#PBS -J 0-1
#PBS -o /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/lab_supcon_training/
#PBS -e /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/lab_supcon_training/
#PBS -k eo

set -e

mkdir -p /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/lab_supcon_training

module load Python/3.12.3-GCCcore-13.3.0
module load CUDA/12.6.0
module load cuDNN/9.10.2.21-CUDA-12.6.0

source /rds/general/user/gk225/home/venv_poc_ddm/bin/activate
export PYTHONPATH="/rds/general/user/gk225/home/POC_DDM:/rds/general/user/gk225/home/POC_DDM/gk_code:$PYTHONPATH"
cd /rds/general/user/gk225/home/POC_DDM/gk_code/main

VALID_IDS=(9 10)
REAL_TASK_ID=${VALID_IDS[$PBS_ARRAY_INDEX]}
EXP_FOLDER=/rds/general/user/gk225/home/refactor/POC_DDM_datasets/LAB_DDM_paper
TRAIN_FOLDER="$EXP_FOLDER"

python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/01b_lab_curve_preprocessing.py --task_id $REAL_TASK_ID --exp_folder "$EXP_FOLDER"
python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/02_outlier_detection_pipeline.py --task_id $REAL_TASK_ID --exp_folder "$TRAIN_FOLDER"

# ── SupCon ST (CE + supervised contrastive; no regression) ──────────────────
python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/03_main_training.py \
    --task_id $REAL_TASK_ID \
    --exp_folder "$TRAIN_FOLDER" \
    --curve_type ori_curve \
    --n_splits 5 \
    --supcon

# ── SupCon MTL (UW-SO + supervised contrastive; classification + regression) ─
python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/03_main_training.py \
    --task_id $REAL_TASK_ID \
    --exp_folder "$TRAIN_FOLDER" \
    --curve_type ori_curve \
    --n_splits 5 \
    --supcon --mtl --force_rerun

deactivate
