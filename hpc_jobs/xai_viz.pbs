#!/bin/bash
#PBS -N xai_viz
#PBS -l walltime=72:00:00
#PBS -J 1-3
#PBS -l select=1:ncpus=8:mem=32gb:ngpus=1
#PBS -o /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/xai_viz
#PBS -e /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/xai_viz
#PBS -k eo

mkdir -p /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/xai_viz

# Load modules
module load Python/3.12.3-GCCcore-13.3.0
module load CUDA/12.6.0
module load cuDNN/9.10.2.21-CUDA-12.6.0

# Activate venv
source /rds/general/user/gk225/home/venv_poc_ddm/bin/activate

export PYTHONPATH="/rds/general/user/gk225/home/POC_DDM:/rds/general/user/gk225/home/POC_DDM/gk_code:$PYTHONPATH"

# Run python script
cd /rds/general/user/gk225/home/POC_DDM/gk_code/main

# Map PBS_ARRAY_INDEX -> dataset subfolder under POC_DDM_datasets (sorted, discovered at runtime)
DATASETS_ROOT="/rds/general/user/gk225/home/POC_DDM_datasets/POC_DDM_datasets"
mapfile -t EXP_FOLDERS < <(find "$DATASETS_ROOT" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort)

EXP_FOLDER="${DATASETS_ROOT}/${EXP_FOLDERS[$((PBS_ARRAY_INDEX-1))]}"

for curve_type in ori_curve ori_curve_avg; do
    python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/07_attribution_vis_all.py --exp_folder "$EXP_FOLDER" --curve_type "$curve_type" --force_rerun
done

deactivate
