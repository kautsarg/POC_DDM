#!/bin/bash
#PBS -N lab_1to1_full_pipeline
#PBS -l walltime=72:00:00
#PBS -l select=1:ncpus=8:mem=32gb:ngpus=1
#PBS -J 0-1
#PBS -o /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/lab_1to1_full_pipeline/
#PBS -e /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/lab_1to1_full_pipeline/
#PBS -k eo

set -e

mkdir -p /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/lab_1to1_full_pipeline

# Load modules
module load Python/3.12.3-GCCcore-13.3.0
module load CUDA/12.6.0
module load cuDNN/9.10.2.21-CUDA-12.6.0

# Activate venv
source /rds/general/user/gk225/home/venv_poc_ddm/bin/activate

export PYTHONPATH="/rds/general/user/gk225/home/POC_DDM:/rds/general/user/gk225/home/POC_DDM/gk_code:$PYTHONPATH"

cd /rds/general/user/gk225/home/POC_DDM/gk_code/main

EXP_FOLDER=/rds/general/user/gk225/home/POC_DDM_datasets/POC_DDM_datasets/LAB_OneToOne
TRAIN_FOLDER="$EXP_FOLDER"

STRATEGIES=(1_area 2_range)
STRATEGY=${STRATEGIES[$PBS_ARRAY_INDEX]}

# Flat task_ids belonging to this strategy, computed dynamically. `tail -n 1` strips
# config's import-time GPU-detection print so it doesn't pollute the word-split loop below.
TASK_IDS=$(python3 -c "
import importlib
mod = importlib.import_module('01b_lab_curve_preprocessing')
combos = mod.discover_one_to_one_combos('$EXP_FOLDER')
ids = [i for i, c in enumerate(combos) if c[0] == '$STRATEGY']
print(' '.join(map(str, ids)))
" | tail -n 1)

echo "Strategy: $STRATEGY -- flat task_ids: $TASK_IDS"

for TID in $TASK_IDS; do
    echo "=== [$STRATEGY] Processing combo flat-task_id=$TID ==="
    python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/01b_lab_curve_preprocessing.py --task_id $TID --exp_folder "$EXP_FOLDER" --one_to_one --force_rerun
    python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/02_outlier_detection_pipeline.py --task_id $TID --exp_folder "$TRAIN_FOLDER" --force_rerun
    python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/03_main_training.py --task_id $TID --exp_folder "$TRAIN_FOLDER" --n_splits 5 --curve_type ori_curve --force_rerun
    python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/06_model_prediction_report.py --task_id $TID --exp_folder "$TRAIN_FOLDER" --n_splits 5 --curve_type ori_curve --force_rerun
done

deactivate
