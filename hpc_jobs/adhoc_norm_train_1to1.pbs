#!/bin/bash
#PBS -N adhoc_norm_train_1to1
#PBS -l walltime=48:00:00
#PBS -l select=1:ncpus=8:mem=32gb:ngpus=1
#PBS -J 0-1
#PBS -o /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/adhoc_norm_train_1to1/
#PBS -e /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/adhoc_norm_train_1to1/
#PBS -k eo

set -e

mkdir -p /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/adhoc_norm_train_1to1

module load Python/3.12.3-GCCcore-13.3.0
module load CUDA/12.6.0
module load cuDNN/9.10.2.21-CUDA-12.6.0

VALID_IDS=(0 2)
PBS_TASK_ID=${VALID_IDS[$PBS_ARRAY_INDEX]}

source /rds/general/user/gk225/home/venv_poc_ddm/bin/activate
export PYTHONPATH="/rds/general/user/gk225/home/POC_DDM:/rds/general/user/gk225/home/POC_DDM/gk_code:$PYTHONPATH"
cd /rds/general/user/gk225/home/POC_DDM/gk_code/main

EXP_FOLDER=/rds/general/user/gk225/home/refactor/POC_DDM_datasets/LAB_OneToOne
TRAIN_FOLDER="$EXP_FOLDER"

STRATEGIES=(1_area 2_range 3_range_filtered)
STRATEGY=${STRATEGIES[$PBS_TASK_ID]}

TASK_IDS=$(python3 -c "
import importlib
mod = importlib.import_module('01b_lab_curve_preprocessing')
combos = mod.discover_one_to_one_combos('$EXP_FOLDER')
ids = [i for i, c in enumerate(combos) if c[0] == '$STRATEGY']
print(' '.join(map(str, ids)))
" | tail -n 1)

echo "Strategy: $STRATEGY -- flat task_ids: $TASK_IDS"

for TID in $TASK_IDS; do
    echo "=== [$STRATEGY] ori_curve_norm backfill flat-task_id=$TID ==="

    python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/03_main_training.py \
        --task_id $TID --exp_folder "$TRAIN_FOLDER" --n_splits 5 --curve_type ori_curve_norm

    python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/06_model_prediction_report.py \
        --task_id $TID --exp_folder "$TRAIN_FOLDER" --n_splits 5 --curve_type ori_curve_norm
done

deactivate
