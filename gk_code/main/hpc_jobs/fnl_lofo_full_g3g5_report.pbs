#!/bin/bash
#PBS -N fnl_lofo_full_g3g5_report
#PBS -l walltime=01:00:00
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -o /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/fnl_lofo_full_g3g5_report/
#PBS -e /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/fnl_lofo_full_g3g5_report/
#PBS -k eo

# 06b_cross_dataset_prediction_report.py only reads cached predictions (joblib) and
# renders plots/HTML -- no model.predict() call, no GPU needed (verified: no
# tensorflow/keras import in that script). Requesting no ngpus also routes this off the
# contended v1_gpu72 queue entirely.
#
# Submit AFTER fnl_lofo_full_g3g5.pbs, with a dependency so this only runs once every
# training array subtask has finished OK -- otherwise a report generated before all 3
# archs for a given group/supcon finish would be incomplete, and 06b's own "skip if the
# report file already exists" behavior means that incomplete version would never get
# regenerated:
#
#   TRAIN_ID=$(qsub fnl_lofo_full_g3g5.pbs)
#   qsub -W depend=afterokarray:${TRAIN_ID} fnl_lofo_full_g3g5_report.pbs

set -e

mkdir -p /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/fnl_lofo_full_g3g5_report

module load Python/3.12.3-GCCcore-13.3.0

source /rds/general/user/gk225/home/venv_poc_ddm/bin/activate

export PYTHONPATH="/rds/general/user/gk225/home/POC_DDM:/rds/general/user/gk225/home/POC_DDM/gk_code:$PYTHONPATH"
cd /rds/general/user/gk225/home/POC_DDM/gk_code/main

EXP_FOLDER="/rds/general/user/gk225/home/POC_DDM_datasets/POC_DDM_final_nc_subtract/"
CURVE_TYPES="ori_curve_wavelet_bior35_norm ori_curve_norm"
FILTERS="noamp_remove"
ALIGN_ARGS="--curve_alignment pc_ttp --pc_ttp_anchor min"

TASK_ID_VALUES=(3 5)
for LOFO_TASK_ID in "${TASK_ID_VALUES[@]}"; do
    GROUP_NAME=$(python3 -c "import config; print(list(config.CROSS_DATASET_GROUPS.keys())[${LOFO_TASK_ID}])" | tail -n 1)
    python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/06b_cross_dataset_prediction_report.py \
        --exp_folder ${EXP_FOLDER} --group ${GROUP_NAME} \
        --mode lofo \
        --curve_type ${CURVE_TYPES} --outlier_filter ${FILTERS} ${ALIGN_ARGS}
done

deactivate
