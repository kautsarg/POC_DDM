#!/bin/bash
#PBS -N fnl_3to5_lofo_full
#PBS -l walltime=72:00:00
#PBS -l select=1:ncpus=16:mem=48gb:ngpus=1
#PBS -o /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/fnl_3to5_lofo_full/
#PBS -e /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/fnl_3to5_lofo_full/
#PBS -k eo

set -e

mkdir -p /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/fnl_3to5_lofo_full

# Load modules
module load Python/3.12.3-GCCcore-13.3.0
module load CUDA/12.6.0
module load cuDNN/9.10.2.21-CUDA-12.6.0

# Activate venv
source /rds/general/user/gk225/home/venv_poc_ddm/bin/activate

export PYTHONPATH="/rds/general/user/gk225/home/POC_DDM:/rds/general/user/gk225/home/POC_DDM/gk_code:$PYTHONPATH"
cd /rds/general/user/gk225/home/POC_DDM/gk_code/main

# EXP_FOLDER="/rds/general/user/gk225/home/POC_DDM_datasets/POC_DDM_final_nc_subtract/"
EXP_FOLDER="/rds/general/user/gk225/home/POC_DDM_datasets/POC_DDM_final/"

BASE_MODELS="cnn_gru_dual_attn_recon" # cnn_gru_dual gnn_gat"
SC0_MODELS="cnn_gru_dual_attn_recon cnn_gru_dual_attn_recon_aug" # supcon-0-only -- _aug isn't combined with SupCon3/DANN
DANN_MODELS="cnn_gru_dual_attn_recon_dann" # cnn_gru_dual_dann gnn_gat_dann"
# CORAL_MODELS="cnn_gru_dual_coral cnn_gru_dual_attn_recon_coral gnn_gat_coral"

CURVE_TYPES="ori_curve_sg_p4_norm"

FILTERS="noamp_remove"

ALIGN_ARGS="--curve_alignment pc_ttp --pc_ttp_anchor min"

GPU_NAME=$(nvidia-smi --query-gpu=name --format=csv,noheader | head -n 1)
case "$GPU_NAME" in
    *A30*) BATCH_SIZE=1024 ;;
    *)     BATCH_SIZE=2048 ;;
esac
echo "  [*] GPU: ${GPU_NAME}  ->  batch_size=${BATCH_SIZE}"

# Mirrors the SLURM version's --array=13 (a single fixed task_id, not a genuine
# multi-task sweep) -- no PBS job array needed for this one.
LOFO_TASK_ID=13
GROUP_NAME=$(python3 -c "import config; print(list(config.CROSS_DATASET_GROUPS.keys())[${LOFO_TASK_ID}])" | tail -n 1)

# 5 independent model variants -- base, +dann, +coral, +SC1, +SC3 -- no combined
# supcon+dann/coral runs. Sequential on this one allocation's GPU.

## DEFAULT
python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/04_cross_dataset_training.py \
    --exp_folder ${EXP_FOLDER} --task_id ${LOFO_TASK_ID} \
    --supcon 0 --curve_type ${CURVE_TYPES} --models ${SC0_MODELS} \
    --outlier_filter ${FILTERS} --batch_size ${BATCH_SIZE} ${ALIGN_ARGS} --train_center_frac 0.5

## DANN
python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/04_cross_dataset_training.py \
    --exp_folder ${EXP_FOLDER} --task_id ${LOFO_TASK_ID} \
    --dann --supcon 0 --curve_type ${CURVE_TYPES} --models ${DANN_MODELS} \
    --outlier_filter ${FILTERS} --batch_size ${BATCH_SIZE} ${ALIGN_ARGS} --train_center_frac 0.5

## SUPCON 3
python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/04_cross_dataset_training.py \
    --exp_folder ${EXP_FOLDER} --task_id ${LOFO_TASK_ID} \
    --supcon 3 --curve_type ${CURVE_TYPES} --models ${BASE_MODELS} \
    --outlier_filter ${FILTERS} --batch_size ${BATCH_SIZE} ${ALIGN_ARGS} --train_center_frac 0.5
    # --train_center_frac 0.5

## SUPCON 1
# python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/04_cross_dataset_training.py \
#     --exp_folder ${EXP_FOLDER} --task_id ${LOFO_TASK_ID} \
#     --supcon 1 --curve_type ${CURVE_TYPES} --models ${BASE_MODELS} \
#     --outlier_filter ${FILTERS} --batch_size ${BATCH_SIZE} ${ALIGN_ARGS} --lofo_limit 1

# python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/06b_cross_dataset_prediction_report.py \
#     --exp_folder ${EXP_FOLDER} --group ${GROUP_NAME} \
#     --mode lofo \
#     --curve_type ${CURVE_TYPES} --outlier_filter ${FILTERS} ${ALIGN_ARGS}

# # python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/04_cross_dataset_training.py \
# #     --exp_folder ${EXP_FOLDER} --task_id ${LOFO_TASK_ID} \
# #     --coral --supcon 0 --curve_type ${CURVE_TYPES} --models ${CORAL_MODELS} \
# #     --outlier_filter ${FILTERS} --batch_size ${BATCH_SIZE} ${ALIGN_ARGS}

deactivate
