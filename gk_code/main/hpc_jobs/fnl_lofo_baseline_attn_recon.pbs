#!/bin/bash
#PBS -N fnl_lofo_baseline_attn_recon
#PBS -l walltime=72:00:00
#PBS -l select=1:ncpus=16:mem=64gb:ngpus=1
# PBS_ARRAY_INDEX -> CROSS_DATASET_GROUPS task_id: 0=3, 1=4, 2=5
#PBS -J 0-2
#PBS -o /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/fnl_lofo_baseline_attn_recon/
#PBS -e /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/fnl_lofo_baseline_attn_recon/
#PBS -k eo

set -e

mkdir -p /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/fnl_lofo_baseline_attn_recon

# Load modules
module load Python/3.12.3-GCCcore-13.3.0
module load CUDA/12.6.0
module load cuDNN/9.10.2.21-CUDA-12.6.0

# Activate venv
source /rds/general/user/gk225/home/venv_poc_ddm/bin/activate

export PYTHONPATH="/rds/general/user/gk225/home/POC_DDM:/rds/general/user/gk225/home/POC_DDM/gk_code:$PYTHONPATH"
cd /rds/general/user/gk225/home/POC_DDM/gk_code/main

EXP_FOLDER="/rds/general/user/gk225/home/POC_DDM_datasets/POC_DDM_final_nc_subtract/"

# Baselining config: 1 LOFO fold, pc_ttp/min alignment only, noamp_remove filter,
# attn_recon architecture only (base/dann/coral), SC0 and SC3 -- see 04_output_map.md
# for what each of these controls in the output layout.
BASE_MODELS="cnn_gru_dual_attn_recon"
CURVE_TYPES="ori_curve_wavelet_bior35_norm ori_curve_norm"
FILTERS="noamp_remove"
ALIGN_ARGS="--curve_alignment pc_ttp --pc_ttp_anchor min"

#### CHECK THE GROUPS!
TASK_IDS=(3 4 5)
LOFO_TASK_ID=${TASK_IDS[$PBS_ARRAY_INDEX]}
GROUP_NAME=$(python3 -c "import config; print(list(config.CROSS_DATASET_GROUPS.keys())[${LOFO_TASK_ID}])" | tail -n 1)

for SUPCON in 0 3; do
    if [ "$SUPCON" -eq 3 ]; then
        DANN_MODELS="cnn_gru_dual_attn_recon_supcon3_dann"
        CORAL_MODELS="cnn_gru_dual_attn_recon_supcon3_coral"
    else
        DANN_MODELS="cnn_gru_dual_attn_recon_dann"
        CORAL_MODELS="cnn_gru_dual_attn_recon_coral"
    fi

    python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/04_cross_dataset_training.py \
        --exp_folder ${EXP_FOLDER} --task_id ${LOFO_TASK_ID} \
        --coral --supcon ${SUPCON} --curve_type ${CURVE_TYPES} --models ${CORAL_MODELS} \
        --outlier_filter ${FILTERS} --lofo_limit 1 --train_center_frac 0.5 ${ALIGN_ARGS}

    python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/04_cross_dataset_training.py \
        --exp_folder ${EXP_FOLDER} --task_id ${LOFO_TASK_ID} \
        --dann --supcon ${SUPCON} --curve_type ${CURVE_TYPES} --models ${DANN_MODELS} \
        --outlier_filter ${FILTERS} --lofo_limit 1 --train_center_frac 0.5 ${ALIGN_ARGS}

    python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/04_cross_dataset_training.py \
        --exp_folder ${EXP_FOLDER} --task_id ${LOFO_TASK_ID} \
        --supcon ${SUPCON} --curve_type ${CURVE_TYPES} --models ${BASE_MODELS} \
        --outlier_filter ${FILTERS} --lofo_limit 1 --train_center_frac 0.5 ${ALIGN_ARGS}
done

python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/06b_cross_dataset_prediction_report.py \
    --exp_folder ${EXP_FOLDER} --group ${GROUP_NAME} \
    --mode lofo \
    --curve_type ${CURVE_TYPES} --outlier_filter ${FILTERS} --train_center_frac 0.5 ${ALIGN_ARGS}

deactivate
