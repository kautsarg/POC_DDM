#!/bin/bash
#PBS -N lab_aligned_full_pipeline
#PBS -l walltime=72:00:00
#PBS -l select=1:ncpus=8:mem=32gb:ngpus=1
#PBS -J 3-5
#PBS -o /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/lab_aligned_full_pipeline/
#PBS -e /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/lab_aligned_full_pipeline/
#PBS -k eo

set -e

mkdir -p /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/lab_aligned_full_pipeline

# Load modules
module load Python/3.12.3-GCCcore-13.3.0
module load CUDA/12.6.0
module load cuDNN/9.10.2.21-CUDA-12.6.0

# Activate venv
source /rds/general/user/gk225/home/venv_poc_ddm/bin/activate

export PYTHONPATH="/rds/general/user/gk225/home/POC_DDM:/rds/general/user/gk225/home/POC_DDM/gk_code:$PYTHONPATH"

cd /rds/general/user/gk225/home/POC_DDM/gk_code/main

REAL_TASK_ID=$((PBS_ARRAY_INDEX))
EXP_FOLDER=/rds/general/user/gk225/home/refactor/POC_DDM_datasets/LAB_DDM_paper
TRAIN_FOLDER="$EXP_FOLDER"

python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/01b_lab_curve_preprocessing.py --task_id $REAL_TASK_ID --exp_folder "$EXP_FOLDER" --ori_curve_aligned

ALIGNED_TID=$(python3 -c "
import os
import config
import importlib
mod = importlib.import_module('01b_lab_curve_preprocessing')
src_names = sorted([n for n in os.listdir('$EXP_FOLDER')
                     if os.path.isdir(os.path.join('$EXP_FOLDER', n)) and n in mod.FILE_MAPPING])
source_name = src_names[$REAL_TASK_ID]
aligned_name = source_name + '_aligned'
all_names = sorted([n for n in os.listdir('$EXP_FOLDER')
                     if os.path.isdir(os.path.join('$EXP_FOLDER', n)) and n not in config.EXCLUDED_FOLDERS])
print(all_names.index(aligned_name))
" | tail -n 1)

echo "Source task_id=$REAL_TASK_ID -> aligned folder task_id=$ALIGNED_TID"

python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/02_outlier_detection_pipeline.py --task_id $ALIGNED_TID --exp_folder "$TRAIN_FOLDER"
python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/03_main_training.py --task_id $ALIGNED_TID --exp_folder "$TRAIN_FOLDER" --n_splits 5 --curve_type ori_curve
python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/06_model_prediction_report.py --task_id $ALIGNED_TID --exp_folder "$TRAIN_FOLDER" --n_splits 5 --curve_type ori_curve
python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/07_attribution_vis_all.py --task_id $ALIGNED_TID --exp_folder "$TRAIN_FOLDER"

deactivate
