#!/bin/bash
#PBS -N lab_1to1_attribution_vis
#PBS -l walltime=72:00:00
#PBS -l select=1:ncpus=8:mem=32gb:ngpus=1
#PBS -J 0-1
#PBS -o /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/lab_1to1_attribution_vis/
#PBS -e /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/lab_1to1_attribution_vis/
#PBS -k eo

set -e

mkdir -p /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/lab_1to1_attribution_vis

# Load modules
module load Python/3.12.3-GCCcore-13.3.0
module load CUDA/12.6.0
module load cuDNN/9.10.2.21-CUDA-12.6.0

# Activate venv
source /rds/general/user/gk225/home/venv_poc_ddm/bin/activate

export PYTHONPATH="/rds/general/user/gk225/home/POC_DDM:/rds/general/user/gk225/home/POC_DDM/gk_code:$PYTHONPATH"

cd /rds/general/user/gk225/home/POC_DDM/gk_code/main

EXP_FOLDER=/rds/general/user/gk225/home/refactor/POC_DDM_datasets/LAB_OneToOne

STRATEGIES=(1_area 2_range)
MODELS=(bigru cnn_gru_dual)
STRATEGY=${STRATEGIES[$PBS_ARRAY_INDEX]}
MODEL=${MODELS[$PBS_ARRAY_INDEX]}

# Flat task_ids belonging to this strategy's combo folders, in 07's own folder-listing
# order (excludes only '.DS_Store'/'model_interpretation', not config.EXCLUDED_FOLDERS).
TASK_IDS=$(python3 -c "
import os
exp_folder = '$EXP_FOLDER'
names = sorted([n for n in os.listdir(exp_folder)
                if os.path.isdir(os.path.join(exp_folder, n)) and n not in ['.DS_Store', 'model_interpretation']])
ids = [i for i, n in enumerate(names) if n.startswith('${STRATEGY}__')]
print(' '.join(map(str, ids)))
" | tail -n 1)

echo "Strategy: $STRATEGY -- model: $MODEL -- flat task_ids: $TASK_IDS"

for TID in $TASK_IDS; do
    echo "=== [$STRATEGY] Processing combo flat-task_id=$TID ==="
    python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/07_attribution_vis_all.py --task_id $TID --exp_folder "$EXP_FOLDER" --curve_type ori_curve # --model_names $MODEL
done

deactivate
