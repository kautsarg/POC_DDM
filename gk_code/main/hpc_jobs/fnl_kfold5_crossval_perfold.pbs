#!/bin/bash
#PBS -N fnl_kfold5_crossval_perfold
#PBS -l walltime=06:00:00
#PBS -l select=1:ncpus=16:mem=48gb:ngpus=1
# PBS_ARRAY_INDEX (0-4) = one of the 5 stratified k-folds. Same models/filter/
# curve_type/train_center_frac as fnl_kfold5_crossval.pbs, just one fold per task
# instead of all 5 run sequentially in one process -- shrinks per-task walltime and
# gives PBS backfill 5 small jobs instead of one big one. Needs
# 04_cross_dataset_training.py's --kfold_index (added alongside this script) since
# there was previously no way to select a single kfold fold -- only --held_out_chip
# existed, and that's LOFO-mode-only.
#PBS -J 0-4
#PBS -o /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/fnl_kfold5_crossval_perfold/
#PBS -e /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/fnl_kfold5_crossval_perfold/
#PBS -k eo

set -e

mkdir -p /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/fnl_kfold5_crossval_perfold

# Load modules
module load Python/3.12.3-GCCcore-13.3.0
module load CUDA/12.6.0
module load cuDNN/9.10.2.21-CUDA-12.6.0

# Activate venv
source /rds/general/user/gk225/home/venv_poc_ddm/bin/activate

export PYTHONPATH="/rds/general/user/gk225/home/POC_DDM:/rds/general/user/gk225/home/POC_DDM/gk_code:$PYTHONPATH"
cd /rds/general/user/gk225/home/POC_DDM/gk_code/main

# EXP_FOLDER="/rds/general/user/gk225/home/POC_DDM_datasets/POC_DDM_final_nc_subtract/"
EXP_FOLDER="/rds/general/user/gk225/home/POC_DDM_datasets/POC_DDM_final/"
MODELS="cnn_gru_dual cnn_gru_dual_attn_recon"
FILTERS="noamp_remove"
TASK_ID=13  #### ===>  13 (nc vs non nc?
CURVE_TYPES="ori_curve_sg_p4_norm"
SUPCON=0

KFOLD_INDEX=${PBS_ARRAY_INDEX}
echo "  [*] PBS_ARRAY_INDEX=${PBS_ARRAY_INDEX} -> kfold_index=${KFOLD_INDEX}"

python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/04_cross_dataset_training.py \
    --exp_folder ${EXP_FOLDER} --task_id ${TASK_ID} \
    --mode kfold --n_splits 5 --kfold_index ${KFOLD_INDEX} \
    --supcon ${SUPCON} --curve_type ${CURVE_TYPES} --models ${MODELS} \
    --outlier_filter ${FILTERS} --batch_size 2048 --train_center_frac 0.5

# 06b report call intentionally omitted here, same as the original
# fnl_kfold5_crossval.pbs (its own 06b call is commented out) -- run it separately
# once all 5 tasks finish.

deactivate
