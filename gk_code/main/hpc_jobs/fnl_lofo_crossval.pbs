#!/bin/bash
#PBS -N fnl_lofo_crossval
#PBS -l walltime=72:00:00
#PBS -l select=1:ncpus=16:mem=64gb:ngpus=1
# PBS_ARRAY_INDEX -> (curve_alignment, supcon):
#   0: acquisition_start + SC3   1: acquisition_start + SC0
#   2: pc_ttp min        + SC3   3: pc_ttp min        + SC0
#PBS -J 0-3
#PBS -o /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/fnl_lofo_crossval/
#PBS -e /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/fnl_lofo_crossval/
#PBS -k eo

set -e

mkdir -p /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/fnl_lofo_crossval

# Load modules
module load Python/3.12.3-GCCcore-13.3.0
module load CUDA/12.6.0
module load cuDNN/9.10.2.21-CUDA-12.6.0

# Activate venv
source /rds/general/user/gk225/home/venv_poc_ddm/bin/activate

export PYTHONPATH="/rds/general/user/gk225/home/POC_DDM:/rds/general/user/gk225/home/POC_DDM/gk_code:$PYTHONPATH"
cd /rds/general/user/gk225/home/POC_DDM/gk_code/main

EXP_FOLDER="/rds/general/user/gk225/home/POC_DDM_datasets/POC_DDM_final_nc_subtract/"

MODELS="knn cnn_gru_dual cnn_gru_dual_attn_recon"
CURVE_TYPES="ori_curve_wavelet_bior35_norm ori_curve_norm" # ori_curve_norm or ori_curve_wavelet_bior35_norm

####################################################################################################
### none or lofo_ae [N/L]
FILTERS="none"
# FILTERS="lofo_ae"

#### CHECK THE GROUP!
LOFO_TASK_ID=4
GROUP_NAME=$(python3 -c "import config; print(list(config.CROSS_DATASET_GROUPS.keys())[${LOFO_TASK_ID}])" | tail -n 1)
####################################################################################################

ALIGN_ARGS_LIST=("" "" "--curve_alignment pc_ttp --pc_ttp_anchor min" "--curve_alignment pc_ttp --pc_ttp_anchor min")
SUPCON_LIST=(3 0 3 0)
ALIGN_ARGS="${ALIGN_ARGS_LIST[$PBS_ARRAY_INDEX]}"
SUPCON="${SUPCON_LIST[$PBS_ARRAY_INDEX]}"

if [ "$SUPCON" -eq 3 ]; then
    DANN_MODELS="cnn_gru_dual_supcon3_dann cnn_gru_dual_attn_recon_supcon3_dann"
    CORAL_MODELS="cnn_gru_dual_supcon3_coral cnn_gru_dual_attn_recon_supcon3_coral"
else
    DANN_MODELS="cnn_gru_dual_dann cnn_gru_dual_attn_recon_dann"
    CORAL_MODELS="cnn_gru_dual_coral cnn_gru_dual_attn_recon_coral"
fi

python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/04_cross_dataset_training.py \
    --exp_folder ${EXP_FOLDER} --task_id ${LOFO_TASK_ID} \
    --coral --supcon ${SUPCON} --curve_type ${CURVE_TYPES} --models ${CORAL_MODELS} \
    --outlier_filter ${FILTERS} --train_full ${ALIGN_ARGS}

python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/04_cross_dataset_training.py \
    --exp_folder ${EXP_FOLDER} --task_id ${LOFO_TASK_ID} \
    --dann --supcon ${SUPCON} --curve_type ${CURVE_TYPES} --models ${DANN_MODELS} \
    --outlier_filter ${FILTERS} --train_full ${ALIGN_ARGS}

python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/04_cross_dataset_training.py \
    --exp_folder ${EXP_FOLDER} --task_id ${LOFO_TASK_ID} \
    --supcon ${SUPCON} --curve_type ${CURVE_TYPES} --models ${MODELS} \
    --outlier_filter ${FILTERS} --train_full ${ALIGN_ARGS}

python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/06b_cross_dataset_prediction_report.py \
    --exp_folder ${EXP_FOLDER} --group ${GROUP_NAME} \
    --mode lofo \
    --curve_type ${CURVE_TYPES} --outlier_filter None ${ALIGN_ARGS}

deactivate
