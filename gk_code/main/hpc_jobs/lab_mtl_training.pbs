#!/bin/bash
#PBS -N lab_mtl_training
#PBS -l walltime=72:00:00
#PBS -l select=1:ncpus=8:mem=32gb:ngpus=1
#PBS -J 0-8
#PBS -o /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/lab_mtl_training/
#PBS -e /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/lab_mtl_training/
#PBS -k eo

set -e

mkdir -p /rds/general/user/gk225/home/POC_DDM/hpc_jobs/logs/lab_mtl_training

# Load modules
module load Python/3.12.3-GCCcore-13.3.0
module load CUDA/12.6.0
module load cuDNN/9.10.2.21-CUDA-12.6.0

# Activate venv
source /rds/general/user/gk225/home/venv_poc_ddm/bin/activate

export PYTHONPATH="/rds/general/user/gk225/home/POC_DDM:/rds/general/user/gk225/home/POC_DDM/gk_code:$PYTHONPATH"

cd /rds/general/user/gk225/home/POC_DDM/gk_code/main

REAL_TASK_ID=$((PBS_ARRAY_INDEX))

EXP_FOLDER=/rds/general/user/gk225/home/refactor/POC_DDM_datasets/LAB_DDM_paper
TRAIN_FOLDER="$EXP_FOLDER"

# MTL training only — results merged into the existing classification_performances*.joblib;
# standard models do not need to be re-run. Uses --n_splits 5 to match standard training.
python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/03_main_training.py \
    --task_id $REAL_TASK_ID \
    --exp_folder "$TRAIN_FOLDER" \
    --curve_type ori_curve \
    --n_splits 5 \
    --mtl

# Report: loads the same joblib, auto-detects MTL keys, appends regression tab.
python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/06_model_prediction_report.py \
    --task_id $REAL_TASK_ID \
    --exp_folder "$TRAIN_FOLDER" \
    --curve_type ori_curve \
    --n_splits 5

# XAI: dual saliency (classification + regression) for MTL models.
python -u /rds/general/user/gk225/home/POC_DDM/gk_code/main/07_attribution_vis_all.py \
    --task_id $REAL_TASK_ID \
    --exp_folder "$TRAIN_FOLDER"

deactivate
